---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonld?: unknown;
  preloadImage?: string;
  adsId?: string;
  adsLabel?: string;
}
const {
  title,
  description = 'Frango assado em Luzimangues (Porto Nacional) - TO. Frango inteiro, meio frango, costela e porções. Peça pelo WhatsApp e retire quentinho.',
  image = '/images/og-image.jpg',
  jsonld,
  preloadImage,
  adsId,
  adsLabel,
} = Astro.props;

const site = Astro.site ?? new URL('https://frango-da-familia.pages.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#c0392b" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
    )}

    <!-- Fontes da marca (carregadas sem bloquear a renderização) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700;800&family=Dancing+Script:wght@600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700;800&family=Dancing+Script:wght@600;700&display=swap" />
    </noscript>

    <!-- Palavras-chave / local -->
    <meta name="keywords" content="frango assado, frango assado Luzimangues, delivery frango Luzimangues, comida Luzimangues, frango Porto Nacional TO, costela assada, porções, Setor Jardim do Porto, Frango da Família" />
    <meta name="author" content="Frango da Família" />
    <meta name="geo.region" content="BR-TO" />
    <meta name="geo.placename" content="Luzimangues, Porto Nacional, Tocantins" />

    <!-- Open Graph (WhatsApp, Facebook, Instagram) -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Frango da Família" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )}

    {adsId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${adsId}`}></script>
      <script is:inline define:vars={{ adsId, adsLabel }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', adsId);
        // Conta clique nos botões do WhatsApp como conversão no Google Ads.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
          if (!a || !adsLabel) return;
          var sendTo = adsLabel.indexOf('/') > -1 ? adsLabel : adsId + '/' + adsLabel;
          gtag('event', 'conversion', { send_to: sendTo });
        }, true);
      </script>
    )}
  </head>
  <body>
    <slot />
    <script is:inline>
      // Corrige a rolagem para âncoras (#info etc.) depois que conteúdos lentos
      // (ex.: feed do Instagram) carregam e mudam a altura da página.
      (function () {
        var userScrolled = false;
        function markScrolled() { userScrolled = true; }
        window.addEventListener('wheel', markScrolled, { passive: true, once: true });
        window.addEventListener('touchmove', markScrolled, { passive: true, once: true });
        function toHash(force) {
          if (!location.hash) return;
          if (userScrolled && !force) return;
          var el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
          if (el) el.scrollIntoView();
        }
        window.addEventListener('load', function () {
          toHash(); setTimeout(function () { toHash(); }, 500); setTimeout(function () { toHash(); }, 1500);
        });
        window.addEventListener('hashchange', function () { userScrolled = false; toHash(true); });
      })();
    </script>
  </body>
</html>
