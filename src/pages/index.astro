---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Chips from '../components/Chips.astro';
import MenuSection from '../components/MenuSection.astro';
import Combo from '../components/Combo.astro';
import Story from '../components/Story.astro';
import Reviews from '../components/Reviews.astro';
import Instagram from '../components/Instagram.astro';
import Info from '../components/Info.astro';
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from '../components/WaIcon.astro';
import { buildSchedule, isOpenNow, todayHorario, openingHoursSpec } from '../lib/hours';

const info = (await getEntry('site', 'info')).data;
const menuEntries = await getCollection('menu', ({ data }) => data.disponivel !== false);
const itens = menuEntries.map((e) => e.data);

const ordemCategorias = ['Frangos e Carnes', 'Porções'];
const categoriasPresentes = [...new Set(itens.map((i) => i.categoria))]
  .sort((a, b) => {
    const ia = ordemCategorias.indexOf(a), ib = ordemCategorias.indexOf(b);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  });

const schedule = buildSchedule(info.horarios);
const openNow = isOpenNow(schedule);
const todayHoras = todayHorario(info.horarios);
const dayText = Array.from({ length: 7 }, (_, wd) => {
  const fake = new Date(2024, 0, 7 + wd); // 2024-01-07 é domingo (wd 0)
  return todayHorario(info.horarios, fake);
});

const waHeroHref = whatsappLink(info.whatsapp, info.mensagem_whatsapp);

// ---- SEO ----
const siteUrl = (Astro.site ?? new URL('https://frango-da-familia.pages.dev')).href.replace(/\/$/, '');
const description = 'Frango da Família — frango assado na brasa em Palmas - TO. Frango inteiro, meio frango, costela assada e porções. Peça pelo WhatsApp e retire quentinho no Setor Jardim do Porto.';
const priceToNumber = (p: string) => (p || '').replace(/[^\d,.-]/g, '').replace(/\./g, '').replace(',', '.');

const hasMenuSection = categoriasPresentes.map((cat) => ({
  '@type': 'MenuSection',
  name: cat,
  hasMenuItem: itens.filter((i) => i.categoria === cat).map((i) => ({
    '@type': 'MenuItem',
    name: i.nome,
    description: i.descricao,
    offers: { '@type': 'Offer', price: priceToNumber(i.preco), priceCurrency: 'BRL' },
  })),
}));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Frango da Família',
  description,
  image: `${siteUrl}/images/og-image.png`,
  url: siteUrl,
  telephone: `+${info.whatsapp}`,
  servesCuisine: ['Frango assado', 'Comida brasileira'],
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Avenida A, Quadra 37, Lote 66 (Avenida do Posto Norte Sul)',
    addressLocality: 'Palmas',
    addressRegion: 'TO',
    addressCountry: 'BR',
  },
  areaServed: 'Palmas - TO',
  sameAs: [info.instagram_url].filter(Boolean),
  openingHoursSpecification: openingHoursSpec(schedule),
  hasMenu: { '@type': 'Menu', hasMenuSection },
  acceptsReservations: 'True',
};
---
<Base title="Frango da Família — Frango assado na brasa em Palmas - TO" description={description} jsonld={jsonld}>
  <TopBar logo={info.logo} openNow={openNow} />
  <Hero
    tagline={info.tagline}
    imagem={info.hero_imagem}
    whatsapp={info.whatsapp}
    mensagem={info.mensagem_whatsapp}
    todayHoras={todayHoras}
    endereco={info.endereco}
    telefone={info.telefone}
  />
  <Chips categorias={categoriasPresentes} />
  <MenuSection itens={itens} whatsapp={info.whatsapp} mensagemBase={info.mensagem_whatsapp} ordemCategorias={ordemCategorias} />
  <Combo titulo={info.promo_titulo} texto={info.promo_texto} imagem={info.promo_imagem} whatsapp={info.whatsapp} mensagem={`${info.mensagem_whatsapp} ${info.promo_titulo}`} />
  <Story whatsapp={info.whatsapp} mensagem={info.mensagem_whatsapp} />
  <Reviews />
  <Instagram handle={info.instagram_handle} url={info.instagram_url} embed={info.instagram_embed} posts={info.instagram_posts} />
  <Info horarios={info.horarios} endereco={info.endereco} mapaUrl={info.mapa_url} telefone={info.telefone} whatsapp={info.whatsapp} whatsapp2={info.whatsapp2} mensagem={info.mensagem_whatsapp} />

  <footer class="site">
    <div style="display:flex;align-items:center;justify-content:center;gap:10px"><img src={info.logo} alt="" width="28" height="28" style="border-radius:8px" /> <strong>Frango da Família</strong> — Palmas, Tocantins</div>
    <div class="small">{info.endereco}</div>
    <div class="small">{info.instagram_handle} · {info.telefone}</div>
    <div class="cnpj">Feito com carinho. Peça pelo WhatsApp!</div>
  </footer>

  <a class="fab" href={waHeroHref} target="_blank" rel="noopener" aria-label="Pedir pelo WhatsApp"><WaIcon size={30} /></a>

  <script define:vars={{ schedule, dayText }}>
    (function () {
      function nowTO() {
        const p = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Araguaina', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
        const map = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
        const wd = map[p.find((x) => x.type === 'weekday').value];
        let h = parseInt(p.find((x) => x.type === 'hour').value, 10);
        if (h === 24) h = 0;
        const m = parseInt(p.find((x) => x.type === 'minute').value, 10);
        return { wd, mins: h * 60 + m };
      }
      const { wd, mins } = nowTO();
      const intervals = (schedule && schedule[wd]) || [];
      const open = intervals.some((i) => mins >= i.start && mins < i.end);
      document.querySelectorAll('[data-openbadge]').forEach((el) => {
        el.classList.toggle('open', open);
        el.classList.toggle('closed', !open);
        const dot = el.querySelector('.dot');
        el.textContent = open ? 'Aberto agora' : 'Fechado agora';
        if (dot) el.prepend(dot);
      });
      document.querySelectorAll('[data-today-horas]').forEach((el) => {
        if (dayText && dayText[wd]) el.textContent = dayText[wd];
      });
    })();
  </script>
</Base>
