---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Chips from '../components/Chips.astro';
import MenuSection from '../components/MenuSection.astro';
import Combo from '../components/Combo.astro';
import Cart from '../components/Cart.astro';
import Story from '../components/Story.astro';
import Reviews from '../components/Reviews.astro';
import Instagram from '../components/Instagram.astro';
import Info from '../components/Info.astro';
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from '../components/WaIcon.astro';
import { buildSchedule, isOpenNow, todayHorario, openingHoursSpec } from '../lib/hours';

const info = (await getEntry('site', 'info')).data;
const menuEntries = await getCollection('menu', ({ data }) => data.disponivel !== false);
const itens = menuEntries.map((e) => e.data);

const ordemCategorias = ['Frangos e Carnes', 'Porções', 'Pastéis', 'Pizza', 'Lasanhas', 'Bebidas', 'Sobremesas'];
const categoriasPresentes = [...new Set(itens.map((i) => i.categoria))]
  .sort((a, b) => {
    const ia = ordemCategorias.indexOf(a), ib = ordemCategorias.indexOf(b);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
  });

const schedule = buildSchedule(info.horarios);
const openNow = isOpenNow(schedule);
const todayHoras = todayHorario(info.horarios);
const dayText = Array.from({ length: 7 }, (_, wd) => {
  const fake = new Date(2024, 0, 7 + wd); // 2024-01-07 é domingo (wd 0)
  return todayHorario(info.horarios, fake);
});

// Configuração enviada ao navegador (disponibilidade por dia + horários + feriados).
const weekendSchedule = schedule[6] || schedule[0] || [];
const fdfConfig = {
  schedule,
  weekendSchedule,
  dayText,
  feriados: info.feriados || [],
  usarFeriados: info.usar_feriados_nacionais !== false,
  whatsapp: info.whatsapp,
};

const waHeroHref = whatsappLink(info.whatsapp, info.mensagem_whatsapp);
const heroWebp = info.hero_imagem.replace(/\.(jpe?g|png)$/i, '.webp');

// ---- SEO ----
const siteUrl = (Astro.site ?? new URL('https://frango-da-familia.pages.dev')).href.replace(/\/$/, '');
const description = 'Frango da Família — frango assado em Luzimangues (Porto Nacional) - TO. Frango inteiro, meio frango, costela assada e porções. Peça pelo WhatsApp e retire quentinho no Setor Jardim do Porto.';
const priceToNumber = (p: string) => (p || '').replace(/[^\d,.-]/g, '').replace(/\./g, '').replace(',', '.');

const hasMenuSection = categoriasPresentes.map((cat) => ({
  '@type': 'MenuSection',
  name: cat,
  hasMenuItem: itens.filter((i) => i.categoria === cat).map((i) => ({
    '@type': 'MenuItem',
    name: i.nome,
    description: i.descricao,
    offers: { '@type': 'Offer', price: priceToNumber(i.preco), priceCurrency: 'BRL' },
  })),
}));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Frango da Família',
  description,
  image: `${siteUrl}/images/og-image.jpg`,
  url: siteUrl,
  telephone: `+${info.whatsapp}`,
  servesCuisine: ['Frango assado', 'Comida brasileira'],
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Avenida A, Quadra 37, Lote 66 (Avenida do Posto Norte Sul), Setor Jardim do Porto, Luzimangues',
    addressLocality: 'Porto Nacional',
    addressRegion: 'TO',
    addressCountry: 'BR',
  },
  areaServed: 'Luzimangues, Porto Nacional - TO',
  ...(info.geo_lat && info.geo_lng
    ? { geo: { '@type': 'GeoCoordinates', latitude: Number(info.geo_lat), longitude: Number(info.geo_lng) } }
    : {}),
  hasMap: info.mapa_url || undefined,
  sameAs: [info.instagram_url].filter(Boolean),
  openingHoursSpecification: openingHoursSpec(schedule),
  hasMenu: { '@type': 'Menu', hasMenuSection },
  acceptsReservations: 'True',
};
---
<Base title="Frango da Família — Frango assado em Luzimangues - TO" description={description} jsonld={jsonld} preloadImage={heroWebp} adsId={info.google_ads_id} adsLabel={info.google_ads_label}>
  <TopBar logo={info.logo} openNow={openNow} />
  <Hero
    tagline={info.tagline}
    imagem={info.hero_imagem}
    whatsapp={info.whatsapp}
    mensagem={info.mensagem_whatsapp}
    todayHoras={todayHoras}
    endereco={info.endereco}
    telefone={info.telefone}
  />
  <Chips categorias={categoriasPresentes} />
  <div class="weekday-note" data-weekdaynote hidden>
    <div class="container">{info.aviso_semana}</div>
  </div>
  <div class="weekday-note" data-fullmenunote hidden>
    <div class="container">{info.aviso_fim_semana}</div>
  </div>
  <MenuSection itens={itens} whatsapp={info.whatsapp} mensagemBase={info.mensagem_whatsapp} ordemCategorias={ordemCategorias} categoriasFimDeSemana={info.categorias_fim_de_semana} categoriasDiasDeSemana={info.categorias_dias_de_semana} />
  <Combo titulo={info.promo_titulo} texto={info.promo_texto} imagem={info.promo_imagem} whatsapp={info.whatsapp} mensagem={info.mensagem_whatsapp} />
  <Story whatsapp={info.whatsapp} mensagem={info.mensagem_whatsapp} titulo={info.historia_titulo} texto={info.historia_texto} imagem={info.historia_imagem} assinatura={info.historia_assinatura} />
  <Reviews />
  <Instagram handle={info.instagram_handle} url={info.instagram_url} embed={info.instagram_embed} posts={info.instagram_posts} />
  <Info horarios={info.horarios} endereco={info.endereco} mapaUrl={info.mapa_url} telefone={info.telefone} whatsapp={info.whatsapp} whatsapp2={info.whatsapp2} mensagem={info.mensagem_whatsapp} geoLat={info.geo_lat} geoLng={info.geo_lng} />

  <footer class="site">
    <div style="display:flex;align-items:center;justify-content:center;gap:10px"><img src={info.logo} alt="" width="28" height="28" style="border-radius:8px" /> <strong>Frango da Família</strong> — Luzimangues, Porto Nacional - TO</div>
    <div class="small">{info.endereco}</div>
    <div class="small">{info.instagram_handle} · {info.telefone}</div>
    <div class="cnpj">Feito com carinho. Peça pelo WhatsApp!</div>
  </footer>

  <a class="fab" href={waHeroHref} target="_blank" rel="noopener" aria-label="Falar no WhatsApp"><WaIcon size={30} /></a>
  <Cart whatsapp={info.whatsapp} />

  <script type="application/json" id="fdf-config" is:inline set:html={JSON.stringify(fdfConfig)} />

  <script>
    import { todayTO, isFullMenuDay } from '../lib/day';
    (function () {
      const cfg = JSON.parse(document.getElementById('fdf-config')?.textContent || '{}');
      const t = todayTO();
      const { fullMenu, holiday } = isFullMenuDay(t, { extra: cfg.feriados, useNational: cfg.usarFeriados });
      document.body.classList.toggle('menu-completo', fullMenu);
      document.body.classList.toggle('menu-semana', !fullMenu);

      // Em feriado (mesmo em dia de semana) usa o horário de fim de semana.
      const intervals = fullMenu ? (cfg.weekendSchedule || []) : ((cfg.schedule && cfg.schedule[t.wd]) || []);
      const open = intervals.some((i) => t.mins >= i.start && t.mins < i.end);
      document.querySelectorAll('[data-openbadge]').forEach((el) => {
        el.classList.toggle('open', open);
        el.classList.toggle('closed', !open);
        const dot = el.querySelector('.dot');
        el.textContent = open ? 'Aberto agora' : 'Fechado agora';
        if (dot) el.prepend(dot);
      });

      let horas = fullMenu ? (cfg.dayText && (cfg.dayText[6] || cfg.dayText[0])) : (cfg.dayText && cfg.dayText[t.wd]);
      if (holiday && horas) horas = 'Feriado — ' + horas;
      document.querySelectorAll('[data-today-horas]').forEach((el) => { if (horas) el.textContent = horas; });

      document.querySelectorAll('[data-weekdaynote]').forEach((el) => { el.hidden = fullMenu; });
      document.querySelectorAll('[data-fullmenunote]').forEach((el) => { el.hidden = !fullMenu; });
    })();
  </script>
</Base>
