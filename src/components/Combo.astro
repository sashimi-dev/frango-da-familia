---
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from './WaIcon.astro';
interface Props { titulo: string; texto: string; imagem?: string; whatsapp: string; mensagem: string; }
const { titulo, texto, whatsapp, mensagem } = Astro.props;
const waHref = whatsappLink(whatsapp, mensagem);
---
<section class="rvideo-band" id="combo" aria-label="Nosso frango assando na hora">
  <video class="rvideo" autoplay muted loop playsinline webkit-playsinline preload="auto" poster="/images/roastery-poster.jpg">
    <source src="/videos/roastery.webm" type="video/webm" />
    <source src="/videos/roastery.mp4" type="video/mp4" />
  </video>
  <img class="rvideo-fallback" src="/images/roastery-poster.jpg" alt="Frango assando no forno do Frango da Família, em Luzimangues" loading="lazy" decoding="async" />
  <div class="rvideo-scrim"></div>
  <div class="rvideo-inner container">
    <span class="rvideo-kicker">Direto do nosso forno</span>
    {titulo && <h2>{titulo}</h2>}
    {texto && <p>{texto}</p>}
    <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener"><WaIcon /> Peça pelo WhatsApp</a>
  </div>
</section>

<script>
  // Alguns navegadores móveis (ex.: Opera) bloqueiam o autoplay. Este empurrãozinho garante a reprodução.
  (function () {
    const v = document.querySelector('.rvideo');
    if (!v) return;
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    v.muted = true; v.defaultMuted = true; v.setAttribute('muted', '');
    const go = () => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };
    go();
    ['touchstart', 'pointerdown', 'click', 'scroll', 'keydown'].forEach((ev) =>
      window.addEventListener(ev, go, { once: true, passive: true })
    );
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) go(); }), { threshold: 0.2 }).observe(v);
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) go(); });
  })();
</script>
