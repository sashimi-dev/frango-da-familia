---
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from './WaIcon.astro';
interface Props { titulo: string; texto: string; imagem: string; whatsapp: string; mensagem: string; }
const { titulo, texto, imagem, whatsapp, mensagem } = Astro.props;
const waHref = whatsappLink(whatsapp, mensagem);
const mostrar = Boolean(titulo || texto);
---
{mostrar && (
  <section class="combo section" id="combo">
    <div class="container">
      <img class="promo-img" src={imagem} alt={titulo} loading="lazy" />
      <div>
        <h2>{titulo}</h2>
        <p>{texto}</p>
        <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener"><WaIcon /> Reservar no Zap</a>
      </div>
    </div>
  </section>
)}
