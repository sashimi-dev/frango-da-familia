---
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from './WaIcon.astro';
import Icon from './Icon.astro';
interface Horario { dias: string; horario: string; }
interface Props {
  horarios: Horario[]; endereco: string; mapaUrl: string;
  telefone: string; whatsapp: string; whatsapp2: string; mensagem: string;
  geoLat?: string; geoLng?: string;
}
const { horarios, endereco, mapaUrl, telefone, whatsapp, whatsapp2, mensagem, geoLat, geoLng } = Astro.props;
// Se houver coordenadas, mostra o ponto exato (com marcador). Senão, cai no endereço.
const mapEmbed = geoLat && geoLng
  ? `https://www.google.com/maps?q=${geoLat},${geoLng}&z=17&hl=pt-BR&output=embed`
  : `https://www.google.com/maps?q=${encodeURIComponent(endereco)}&output=embed`;
// Botão "abrir": usa o link salvo (lugar exato) ou as coordenadas.
const mapOpen = mapaUrl || (geoLat && geoLng ? `https://www.google.com/maps/search/?api=1&query=${geoLat},${geoLng}` : '');
const wa1 = whatsappLink(whatsapp, mensagem);
const wa2 = whatsapp2 ? whatsappLink(whatsapp2, mensagem) : '';
const formatBR = (raw: string) => {
  const d = (raw || '').replace(/\D/g, '').replace(/^55/, '');
  if (d.length < 10) return raw;
  const ddd = d.slice(0, 2);
  const rest = d.slice(2);
  return `(${ddd}) ${rest.slice(0, rest.length - 4)}-${rest.slice(-4)}`;
};
const tel2 = whatsapp2 ? formatBR(whatsapp2) : '';
---
<section class="info section" id="info">
  <div class="container">
    <div class="sec-head">
      <div class="kicker">Onde e quando</div>
      <h2>Horários e endereço</h2>
      <p>Retirada no local, no Setor Jardim do Porto — Luzimangues, Porto Nacional - TO.</p>
    </div>
    <div class="container-grid">
      <div class="info-card">
        <h3><Icon name="clock" size={20} /> Horários</h3>
        <ul class="hours">
          {horarios.map((h) => (
            <li><span>{h.dias}</span><span class="h">{h.horario}</span></li>
          ))}
        </ul>
      </div>
      <div class="info-card">
        <h3><Icon name="pin" size={20} /> Contato e retirada</h3>
        <p class="addr">{endereco}</p>
        <div style="display:flex;flex-direction:column;gap:10px">
          <a class="btn btn-wa" href={wa1} target="_blank" rel="noopener"><WaIcon /> {telefone || 'WhatsApp 1'}</a>
          {wa2 && <a class="btn btn-wa" href={wa2} target="_blank" rel="noopener"><WaIcon /> {tel2}</a>}
          {mapOpen && <a class="btn btn-gold" href={mapOpen} target="_blank" rel="noopener">Abrir no Google Maps</a>}
        </div>
      </div>
      <iframe class="map" src={mapEmbed} loading="lazy" title="Mapa — Frango da Família" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
