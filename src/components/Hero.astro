---
import { whatsappLink } from '../lib/whatsapp';
import WaIcon from './WaIcon.astro';
import Icon from './Icon.astro';
import { imgSrc } from '../lib/img';
interface Props {
  tagline: string; imagem: string; whatsapp: string; mensagem: string;
  todayHoras: string; endereco: string; telefone: string;
}
const { tagline, imagem, whatsapp, mensagem, todayHoras, endereco, telefone } = Astro.props;
const waHref = whatsappLink(whatsapp, mensagem);
const heroWebp = imgSrc(imagem.replace(/\.(jpe?g|png)$/i, '.webp'));
---
<section class="hero" id="topo">
  <picture>
    <source srcset={heroWebp} type="image/webp" />
    <img class="bg" src={imgSrc(imagem)} alt="Frango assado no ponto certo — Frango da Família em Luzimangues, Porto Nacional" width="1200" height="800" fetchpriority="high" decoding="async" />
  </picture>
  <div class="scrim"></div>
  <div class="container">
    <div class="inner">
      <span class="eyebrow"><Icon name="flame" size={16} /> Frango assado • Luzimangues - TO</span>
      <h1>Sabor caseiro que reúne todo mundo</h1>
      <p class="tag">{tagline}</p>
      <div class="cta">
        <a class="btn btn-wa" href={waHref} target="_blank" rel="noopener"><WaIcon /> Pedir pelo WhatsApp</a>
        <a class="btn btn-ghost" href="#cardapio">Ver cardápio</a>
      </div>
      <div class="meta">
        <div><span>Hoje</span><b data-today-horas>{todayHoras}</b></div>
        <div><span>Retirada</span><b>Jardim do Porto, Luzimangues</b></div>
        {telefone && <div><span>Pedidos</span><b>{telefone}</b></div>}
      </div>
    </div>
  </div>
</section>
