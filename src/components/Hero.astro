---
import { whatsappLink } from '../lib/whatsapp';

interface Props {
  tagline: string;
  imagem: string;
  whatsapp: string;
  mensagem: string;
}
const { tagline, imagem, whatsapp, mensagem } = Astro.props;
const waHref = whatsappLink(whatsapp, mensagem);
---
<section class="hero" id="topo">
  <img class="bg" src={imagem} alt="Frango assado na brasa" width="1200" height="800" />
  <div class="scrim"></div>
  <div class="inner">
    <h1>Frango da Família</h1>
    <p class="tagline">{tagline}</p>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; justify-content:center;">
      <a class="btn btn-wa" href={waHref} target="_blank" rel="noopener">
        <span aria-hidden="true">💬</span> Pedir pelo WhatsApp
      </a>
      <a class="btn btn-ghost" href="#cardapio">Ver cardápio</a>
    </div>
  </div>
</section>
