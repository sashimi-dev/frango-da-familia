---
import { imgSrc, slugify } from '../lib/img';
import AddControl from './AddControl.astro';

interface Props {
  nome: string;
  descricao: string;
  preco: string;
  foto: string;
  whatsapp?: string;
  mensagemBase?: string;
  weekendOnly?: boolean;
  weekdayOnly?: boolean;
}
const { nome, descricao, preco, foto, weekendOnly, weekdayOnly } = Astro.props;
// Foto do cardápio: usa a versão limpa e otimizada gerada no build
// (public/images/menu/<slug>.jpg). Se for placeholder/svg, usa o arquivo direto.
const temFoto = foto && /\.(jpe?g|png|webp)$/i.test(foto);
const fotoSrc = temFoto ? `/images/menu/${slugify(nome)}.jpg` : imgSrc(foto);
---
<article class="item">
  <img class="photo" src={fotoSrc} alt={`${nome} — Frango da Família, Luzimangues`} loading="lazy" width="600" height="450" decoding="async" />
  <div class="body">
    <h4 class="name">{nome}</h4>
    <p class="desc">{descricao}</p>
    <div class="row">
      <span class="price"><small>R$</small> {preco}</span>
      <AddControl nome={nome} preco={preco} weekendOnly={weekendOnly} weekdayOnly={weekdayOnly} />
    </div>
  </div>
</article>
