---
import { imgSrc, slugify } from '../lib/img';

interface Props {
  nome: string;
  descricao: string;
  preco: string;
  foto: string;
  whatsapp?: string;
  mensagemBase?: string;
}
const { nome, descricao, preco, foto } = Astro.props;
// Foto do cardápio: usa a versão limpa e otimizada gerada no build
// (public/images/menu/<slug>.jpg). Se for placeholder/svg, usa o arquivo direto.
const temFoto = foto && /\.(jpe?g|png|webp)$/i.test(foto);
const fotoSrc = temFoto ? `/images/menu/${slugify(nome)}.jpg` : imgSrc(foto);
---
<article class="item">
  <img class="photo" src={fotoSrc} alt={`${nome} — Frango da Família, Luzimangues`} loading="lazy" width="600" height="450" decoding="async" />
  <div class="body">
    <h4 class="name">{nome}</h4>
    <p class="desc">{descricao}</p>
    <div class="row">
      <span class="price"><small>R$</small> {preco}</span>
      <div class="add" data-additem data-nome={nome} data-preco={preco}>
        <button type="button" class="mini add-btn" data-add aria-label={`Adicionar ${nome} ao pedido`}>+ Adicionar</button>
        <div class="stepper" data-stepper hidden>
          <button type="button" class="step" data-dec aria-label={`Diminuir ${nome}`}>−</button>
          <span class="qty" data-qty>1</span>
          <button type="button" class="step" data-inc aria-label={`Aumentar ${nome}`}>+</button>
        </div>
      </div>
    </div>
  </div>
</article>
