---
import MenuItem from './MenuItem.astro';
interface Item { nome: string; descricao: string; preco: string; categoria: string; foto: string; ordem: number; }
interface Props { itens: Item[]; whatsapp: string; mensagemBase: string; ordemCategorias: string[]; }
const { itens, whatsapp, mensagemBase, ordemCategorias } = Astro.props;

const slug = (s: string) => 'cat-' + s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const porCategoria: Record<string, Item[]> = {};
const vistas: string[] = [];
for (const item of itens) {
  if (!porCategoria[item.categoria]) { porCategoria[item.categoria] = []; vistas.push(item.categoria); }
  porCategoria[item.categoria].push(item);
}
const ordenadas = [
  ...ordemCategorias.filter((c) => porCategoria[c]),
  ...vistas.filter((c) => !ordemCategorias.includes(c)),
];
for (const c of ordenadas) porCategoria[c].sort((a, b) => a.ordem - b.ordem);
---
<section class="section" id="cardapio">
  <div class="container">
    <div class="sec-head">
      <div class="kicker">Cardápio</div>
      <h2>Feito na hora, com carinho</h2>
      <p>Peça pelo WhatsApp e retire quentinho.</p>
    </div>
    {ordenadas.map((cat) => (
      <div class="cat" id={slug(cat)}>
        <h3>{cat}</h3>
        <div class="grid">
          {porCategoria[cat].map((item) => (
            <MenuItem nome={item.nome} descricao={item.descricao} preco={item.preco} foto={item.foto} whatsapp={whatsapp} mensagemBase={mensagemBase} />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
