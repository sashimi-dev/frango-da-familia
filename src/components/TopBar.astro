---
interface Props { logo: string; openNow: boolean; }
const { openNow } = Astro.props;
---
<header class="topbar">
  <div class="container">
    <a class="brandmark" href="#topo" aria-label="Frango da Família — início">
      <img src="/images/logotipo.png" alt="Frango da Família" height="44" />
    </a>
    <nav class="navlinks">
      <a href="#cardapio">Cardápio</a>
      <a href="#historia">Nossa história</a>
      <a href="#info">Horários</a>
      <a href="#info">Endereço</a>
    </nav>
    <div class="right">
      <span class={`badge ${openNow ? 'open' : 'closed'}`} data-openbadge>
        <span class="dot"></span>{openNow ? 'Aberto agora' : 'Fechado agora'}
      </span>
    </div>
  </div>
</header>
