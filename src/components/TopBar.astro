---
import Icon from './Icon.astro';
interface Props { logo: string; openNow: boolean; }
const { openNow } = Astro.props;
---
<header class="topbar" id="topbar">
  <div class="container">
    <a class="brandmark" href="#topo" aria-label="Frango da Família — início">
      <img class="mark" src="/images/logo.webp" alt="" width="56" height="56" decoding="async" />
      <img class="word" src="/images/wordmark.webp" alt="Frango da Família" width="480" height="61" decoding="async" />
    </a>

    <nav class="navlinks" id="mainnav">
      <span class={`badge ${openNow ? 'open' : 'closed'} navstatus`} data-openbadge>
        <span class="dot"></span>{openNow ? 'Aberto agora' : 'Fechado agora'}
      </span>
      <a href="#cardapio">Cardápio</a>
      <a href="#historia">Nossa história</a>
      <a href="#info">Horários</a>
      <a href="#info">Endereço</a>
    </nav>

    <div class="right">
      <span class={`badge ${openNow ? 'open' : 'closed'} deskstatus`} data-openbadge>
        <span class="dot"></span>{openNow ? 'Aberto agora' : 'Fechado agora'}
      </span>
      <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mainnav">
        <Icon name="menu" size={28} />
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var bar = document.getElementById('topbar');
    var btn = bar && bar.querySelector('.menu-toggle');
    var nav = document.getElementById('mainnav');
    if (!bar || !btn || !nav) return;
    function setOpen(open) {
      bar.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      setOpen(!bar.classList.contains('nav-open'));
    });
    nav.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
  })();
</script>
